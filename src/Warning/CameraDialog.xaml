<Window x:Class="Baldur.Warning.CameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baldur" Width="380" Height="150"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="LightGray"
        Icon="pack://application:,,,/Baldur;component/Assets/Baldur.png"
        KeyDown="OnKeyDown">
    <StackPanel Margin="0,0,0,0">
        <TextBlock x:Name="MessageText" x:FieldModifier="public"
                   Text="Camera is unavailable !!!" Foreground="Black" FontSize="16"
                   HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
            <Button x:Name="ContinueButton" x:FieldModifier="public"
                    Content="Continue" MinWidth="96"  Margin="12,0,0,0"
                    Click="OnContinueClick"/>
            <Button x:Name="CloseButton" x:FieldModifier="public"
                    Content="Close" MinWidth="96" Margin="12,0,12,12"
                    Click="OnCloseClick"/>
        </StackPanel>
    </StackPanel>
</Window>
