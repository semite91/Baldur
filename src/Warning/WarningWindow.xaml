<Window x:Class="Baldur.Warning.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baldur Posture Warning"
        WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" Background="Black"
        KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderText" x:FieldModifier="public" Grid.Row="0"
                   Text="STAND TALL!!!" Foreground="Red" FontSize="72"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,40,0,0"/>
        <Image x:Name="PostureImage" x:FieldModifier="public" Grid.Row="1"
               Source="pack://application:,,,/Warning;component/Assets/kyphosis.jpg" Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="EscHint" x:FieldModifier="public" Grid.Row="2"
                   Text="Press ESC to dismiss" Foreground="White" FontSize="24"
                   HorizontalAlignment="Center" Margin="0,0,0,40"/>
        <TextBlock x:Name="DetailText" x:FieldModifier="public" Grid.Row="1"
                   Text="" Foreground="White" FontSize="20" Visibility="Hidden"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
    </Grid>
</Window>
